@model RaceDay.MVC.Models.EventDto
@{
	ViewData["Title"] = "Event Details";
}
<div class="row mt-4">
	<div class="col-md-8">
		<h2>@Model.EventName</h2><p>@Model.Description</p>
		<ul class="list-group"><li class="list-group-item">Date: @Model.EventDate.ToString("dd MMM yyyy")</li><li class="list-group-item">Location: @Model.Location</li></ul>
	</div>
	<div class="col-md-4">
		<div class="card">
			<div class="card-header">Enrol</div><div class="card-body">
			@if (TempData["ErrorMessage"] != null)
			{
				<div class="alert alert-danger">@TempData["ErrorMessage"]</div>
			}
			<form asp-action="Enrol" method="post">
				<input type="hidden" name="eventId" value="@Model.EventID" />
				<select name="categoryId" class="form-select mb-3" required>
					<option value="">-- Select --</option>
					@foreach (var cat in ViewBag.Categories as List<RaceDay.MVC.Models.CategoryDto> ?? new())
					{
						<option value="@cat.CategoryID">@cat.CategoryName</option>
					}
				</select>
				<button type="submit" class="btn btn-success w-100">Enrol Now</button>				</form>
			</div>
		</div>
	</div>
</div>