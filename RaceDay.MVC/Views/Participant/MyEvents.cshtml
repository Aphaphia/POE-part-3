@model List<RaceDay.MVC.Models.EnrollmentDto>
@{ ViewData["Title"] = "My Enrolments"; }

<h2 class="mt-4">My Enrolments</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
}

<table class="table table-hover mt-4 shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Event</th>
            <th>Category</th>
            <th>Date Enrolled</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var enr in Model)
        {
            <tr>
                <td>@enr.EventName</td>
                <td>@enr.CategoryName</td>
                <td>@enr.EnrollmentDate.ToString("dd MMM yyyy")</td>
                <td>
                    <span class="badge @(enr.Status == "Confirmed" ? "bg-success" : "bg-warning text-dark")">
                        @enr.Status
                    </span>
                </td>
            </tr>
        }
    </tbody>
</table>